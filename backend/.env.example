# Base de datos (Supabase). DATABASE_URL va por el pooler; DIRECT_URL la usan las migraciones.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3001

# Al menos 32 caracteres al azar:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<un-string-largo-y-aleatorio>

# Supabase Storage (fotos de prendas). La clave es secreta: solo backend, nunca en la app.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-clave-secreta

NODE_ENV=development
# Sitios que pueden llamar a la API desde el navegador (versión web), separados por comas.
CORS_ORIGENES=http://localhost:8081
